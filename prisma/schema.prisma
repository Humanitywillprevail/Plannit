// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// userId는 Supabase Auth(auth.users.id, uuid)를 가리킨다.
// Prisma가 관리하지 않는 스키마라 관계(relation)가 아닌 평범한 컬럼으로 둔다.
model Semester {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String // 자유 입력, 예: "2024-1학기"
  createdAt DateTime @default(now())
  courses   Course[]

  @@index([userId])
}

model Course {
  id           Int                @id @default(autoincrement())
  userId       String
  semesterId   Int
  name         String
  credit       Int
  grade        String? // "A+" | "A0" | "B+" | "B0" | "C+" | "C0" | "D+" | "D0" | "F" | null(미입력)
  selfRating   Int? // 자기평가: 이 과목을 얼마나 이해했다고 느끼는지 (1~5). 성적/키워드 분석과는 별개의 주관적 지표.
  createdAt    DateTime           @default(now())
  semester     Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  records      Record[]
  competencies CourseCompetency[]

  @@index([userId])
}

model Record {
  id             Int          @id @default(autoincrement())
  userId         String
  courseId       Int
  type           String // "assignment" | "exam" | "project" | "other"
  content        String
  // 아래는 나중에 만들 "포트폴리오 자동 생성" 기능(7단계 스토리 구조)을 위해
  // 미리 준비해두는 선택 입력 필드. 지금은 기록 폼에서 펼치기로 입력만 받고,
  // 이 데이터를 실제로 글로 재구성하는 기능은 아직 없다.
  summary        String? // 소개: 한 줄 요약
  background     String? // 배경/목적: 왜 이 활동을 하게 됐는지
  process        String? // 과정: 어떤 액션을 했고 어떤 인사이트를 얻었는지
  outcome        String? // 결과물: 최종적으로 만들어낸 것
  growth         String? // 성장한 점
  competencyNote String? // 나의 역량: 느낀 점, 배운 점, 다짐
  narrative      Json? // LLM이 생성한 7단계 내러티브({ intro, background, process, outcome, growth, competency }). null = 아직 생성 안 됨.
  createdAt      DateTime     @default(now())
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attachments    Attachment[]
  portfolios     PortfolioRecord[]

  @@index([userId])
}

// 포트폴리오용 첨부파일. 실제 파일은 오브젝트 스토리지(S3 호환)에 저장하고 공개 URL만 둔다.
model Attachment {
  id        Int      @id @default(autoincrement())
  recordId  Int
  fileName  String // 원본 파일명 (표시용)
  url       String // 오브젝트 스토리지의 공개 URL
  mimeType  String
  size      Int // bytes
  createdAt DateTime @default(now())
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

// 역량 사전 (마스터 데이터). 코드상의 keywordDictionary.ts를 seed 스크립트로 반영한다.
model Competency {
  id       Int                @id @default(autoincrement())
  key      String             @unique // e.g. "programming"
  name     String // "프로그래밍"
  category String? // "기술" | "소프트스킬" 등
  keywords String // comma-separated, 참고용 (실제 매칭은 keywordDictionary.ts 기준)
  courses  CourseCompetency[]
}

// 과목 x 역량 분석 결과
model CourseCompetency {
  id              Int     @id @default(autoincrement())
  courseId        Int
  competencyId    Int
  score           Int // 매칭 강도 (키워드 매칭 횟수 기반)
  matchedKeywords String // comma-separated, 실제 매칭된 키워드
  evidence        String? // 매칭이 발생한 텍스트 스니펫

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([courseId, competencyId])
}

// 직무 타겟 포트폴리오. 사용자가 목표 직무 하나당 활동(Record)을 골라 담아서
// 저장하는 단위. 같은 활동이 여러 포트폴리오에 동시에 들어갈 수 있다
// (직무를 바꿔가며 여러 개 만드는 시나리오를 지원하기 위해 M:N으로 둔다).
model Portfolio {
  id            Int       @id @default(autoincrement())
  userId        String
  name          String
  targetJobRole String
  feedback      Json? // 마지막 analyzePortfolio 결과 스냅샷. null = 아직 분석 안 함.
  analyzedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  records       PortfolioRecord[]

  @@index([userId])
}

model PortfolioRecord {
  portfolioId Int
  recordId    Int
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  record      Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@id([portfolioId, recordId])
}
